# Copie para .env e preencha com as credenciais da sua aplicação em
# Mercado Pago → Suas integrações → Credenciais. Nunca commitar o .env real.

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# E-mail de acesso (resend.com), ver api/_email.ts.
RESEND_API_KEY=
EMAIL_FROM=

# Banco de dados (supabase.com), ver api/_supabase.ts.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
